<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Sanet.MakaMek.MapEditor</AssemblyName>
    <RootNamespace>Sanet.MakaMek.MapEditor</RootNamespace>
    <Description>Map editor for MakaMek</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncAwaitBestPractices" Version="10.0.0" />
    <PackageReference Include="AsyncAwaitBestPractices.MVVM" Version="10.0.0" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
    <PackageReference Include="Sanet.MakaMek.Map" Version="0.63.0" />
    <PackageReference Include="Sanet.MakaMek.Services" Version="0.63.0" />
    <PackageReference Include="Sanet.MakaMek.Services.Avalonia" Version="0.63.0" />
    <PackageReference Include="Sanet.MakaMek.Avalonia.Controls" Version="0.63.0" />
    <PackageReference Include="Sanet.MVVM.Core" Version="1.7.0" />
    <PackageReference Include="Sanet.MVVM.DI.Avalonia" Version="1.7.1211" />
    <PackageReference Include="Sanet.MVVM.Navigation.Avalonia" Version="1.7.1211" />
    <PackageReference Include="Sanet.MVVM.Views.Avalonia" Version="1.6.1211" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\avalonia-logo.ico" />
    <AvaloniaResource Include="Assets\terrain\*" />
    <AvaloniaResource Include="Assets\tools\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Maps\clear.json" />
  </ItemGroup>

</Project>
